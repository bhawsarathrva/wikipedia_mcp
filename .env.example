# ==============================================================================
# Wikipedia MCP Agent Environment Configuration
# ==============================================================================

# LLM Provider: 'ollama' (local default), 'gemini', or 'openai'
LLM_PROVIDER=ollama

# Local Ollama Configuration (e.g. gemma4:latest)
OLLAMA_MODEL=gemma4:latest
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini API Key (Required only if LLM_PROVIDER=gemini)
# Get a key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Required only if LLM_PROVIDER=openai)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Model Context Protocol (MCP) Server Subprocess Command
# Leave empty to use current python virtual environment executable
MCP_SERVER_COMMAND=python
MCP_SERVER_SCRIPT=mcp_server/server.py
MCP_SERVER_TIMEOUT=25.0

# Backend & Network Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
BACKEND_URL=http://localhost:8000

# Wikimedia API Compliance User-Agent
WIKIPEDIA_USER_AGENT="WikipediaMCPAgentBot/1.0 (https://github.com/athrvabhawsar07/wikipedia-mcp-agent; athrvabhawsar07@gmail.com)"
